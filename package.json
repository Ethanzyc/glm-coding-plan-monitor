{
  "name": "glm-coding-plan-monitor",
  "version": "1.0.0",
  "description": "GLM Coding Plan usage monitor - Chrome extension",
  "author": "zhuyuchen",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"node scripts/build-bg.mjs --watch\"",
    "build": "vite build && node scripts/build-bg.mjs",
    "pack": "npm run build && cd dist && zip -r ../glm-coding-plan-monitor.zip . && cd .. && echo packed: glm-coding-plan-monitor.zip",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@vitejs/plugin-vue": "^6.0.5",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.4",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "vue": "^3.5.32",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.3.0"
  }
}
